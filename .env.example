APP_NAME="Tender Finder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tenderfinder.test

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tender_finder
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public VPS hostname used by Caddy; no protocol and no path.
APP_DOMAIN=tender-finder.example.com

# Telegram server-side identity and bot. Values live only in the VPS secret store.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_BOT_REQUEST_TIMEOUT_SECONDS=5

# Public legal documents are required before a trial can start.
LEGAL_OFFER_URL=
LEGAL_OFFER_VERSION=
LEGAL_PRIVACY_URL=
LEGAL_PRIVACY_VERSION=

# Operator-only readiness endpoint. Never expose or commit this token.
OPERATIONS_READINESS_TOKEN=

# Access policy for the closed beta.
TRIAL_DURATION_HOURS=72
BASIC_ACTIVE_QUERY_LIMIT=3

# RSS stays disabled until SRC-00 validates live EIS feeds.
RSS_LIVE_POLLING_ENABLED=false
RSS_MAX_ACTIVE_FEEDS=100
RSS_POLL_INTERVAL_SECONDS=600
RSS_GLOBAL_MIN_INTERVAL_MILLISECONDS=1500
RSS_MAX_RESPONSE_BYTES=5242880
RSS_REQUEST_TIMEOUT_SECONDS=30
