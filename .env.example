APP_NAME="Tender Finder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tenderfinder.test

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tender_finder
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public VPS hostname used by Caddy; no protocol and no path.
APP_DOMAIN=tender-finder.example.com

# Telegram server-side identity and bot. Values live only in the VPS secret store.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Personal Telegram user IDs, separated by commas. These IDs become
# super_admin only after Telegram has cryptographically signed Mini App data.
TELEGRAM_SUPERADMIN_IDS=
# Legacy single-owner alias; optional when TELEGRAM_SUPERADMIN_IDS is used.
TELEGRAM_OWNER_ID=
# Optional HTTPS URL used by the private-chat "Open Tender Finder" button.
# When empty, APP_URL is used.
TELEGRAM_MINI_APP_URL=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
TELEGRAM_BOT_REQUEST_TIMEOUT_SECONDS=5

# Public legal documents are required before a trial can start.
LEGAL_DOCUMENTS_PUBLISHED=false
LEGAL_OFFER_URL=
LEGAL_OFFER_VERSION=
LEGAL_PRIVACY_URL=
LEGAL_PRIVACY_VERSION=

# Operator-only readiness endpoint. Never expose or commit this token.
OPERATIONS_READINESS_TOKEN=

# Access policy for the closed beta.
TRIAL_DURATION_HOURS=72
BASIC_ACTIVE_QUERY_LIMIT=3
PRO_ACTIVE_QUERY_LIMIT=10

# Telegram Stars: set the approved XTR amounts before enabling. The historical
# 990/2990 ₽ prices are product policy, not a safe conversion to Stars.
TELEGRAM_STARS_ENABLED=false
TELEGRAM_STARS_BASIC_PRICE_XTR=0
TELEGRAM_STARS_PRO_PRICE_XTR=0
TELEGRAM_STARS_SUBSCRIPTION_PERIOD_SECONDS=2592000

# Placeholder for a future external YooKassa checkout. Never use YooKassa for
# digital services sold inside Telegram Mini Apps.
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Explicit, short-lived Railway test access. Keep false outside a supervised
# pre-MVP session; the link itself is generated in the Railway console.
REMOTE_MVP_OPERATOR_ENABLED=false


# RosTender remains inactive until the supplier has given written permission
# to distribute API data to Tender Finder users. Never commit an API key.
ROSTENDER_ENABLED=false
ROSTENDER_PUBLIC_DISTRIBUTION_APPROVED=false
ROSTENDER_API_KEY=
ROSTENDER_BASE_URL=https://rostender.info/api/tenders/get
ROSTENDER_REQUEST_TIMEOUT_SECONDS=15
ROSTENDER_DAILY_QUOTA_LIMIT=200
ROSTENDER_DAILY_QUOTA_RESERVE=20
ROSTENDER_MAX_DETAILS_PER_POLL=20
ROSTENDER_BASIC_POLL_INTERVAL_SECONDS=3600
ROSTENDER_PRO_POLL_INTERVAL_SECONDS=3600
ROSTENDER_BASIC_MANUAL_CHECKS_PER_DAY=0
ROSTENDER_PRO_MANUAL_CHECKS_PER_DAY=0
# Keep at zero until the licensed product policy has been approved.
ROSTENDER_BASIC_ACTIVE_MONITOR_LIMIT=0
ROSTENDER_PRO_ACTIVE_MONITOR_LIMIT=0

# Public Sberbank-AST registries. No supplier login or password is required.
# Add more section registries as a comma-separated list after each one has
# been checked against the current public HTML and platform terms.
SBER_AST_ENABLED=false
SBER_AST_REGISTRY_URLS=https://utp.sberbank-ast.ru/VIP/List/PurchaseList
SBER_AST_REQUEST_TIMEOUT_SECONDS=15
SBER_AST_POLL_INTERVAL_SECONDS=3600
SBER_AST_USER_AGENT="TenderFinder/1.0 (+public procurement monitoring)"

# Official public tender RSS. No Workspace.ru account is required.
WORKSPACE_RU_ENABLED=false
WORKSPACE_RU_FEED_URL=https://workspace.ru/tenders/rss/
WORKSPACE_RU_REQUEST_TIMEOUT_SECONDS=15
WORKSPACE_RU_POLL_INTERVAL_SECONDS=3600
WORKSPACE_RU_USER_AGENT="TenderFinder/1.0 (+public tender RSS monitoring)"

# Public B2B-Center catalog. No account credentials are required.
B2B_CENTER_ENABLED=false
B2B_CENTER_CATALOG_URL=https://www.b2b-center.ru/market/
B2B_CENTER_REQUEST_TIMEOUT_SECONDS=15
B2B_CENTER_POLL_INTERVAL_SECONDS=3600
B2B_CENTER_USER_AGENT="TenderFinder/1.0 (+public tender catalog monitoring)"

# Public platform-specific search pages on B2B-Center (B2B-RTS).
# These are bounded catalog samples, not complete platform archives.
ROSELTORG_CATALOG_ENABLED=false
RTS_TENDER_CATALOG_ENABLED=false
PLATFORM_CATALOG_PAGES_PER_POLL=5
PLATFORM_CATALOG_REQUEST_TIMEOUT_SECONDS=15
PLATFORM_CATALOG_POLL_INTERVAL_SECONDS=1800
PLATFORM_CATALOG_USER_AGENT="TenderFinder/1.0 (+public platform catalog monitoring)"
