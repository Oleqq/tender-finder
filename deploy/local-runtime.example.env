# Copy this file manually to deploy/local-runtime.env. That local file is ignored
# by Git and must never be pasted into chat or committed.
#
# Generate APP_KEY on your own computer with:
# php artisan key:generate --show
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Local fixtures are allowed; real EIS network polling stays blocked until SRC-00.
RSS_LIVE_POLLING_ENABLED=false
LEGAL_DOCUMENTS_PUBLISHED=false
